<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set page_title = settings.site.naam_deel1 + " " + settings.site.naam_deel2 + " — Liefdevolle kraamzorg" %}
{% set page_description = settings.site.naam_deel1 + " " + settings.site.naam_deel2 + " biedt persoonlijke en professionele kraamzorg voor jou en je gezin." %}
<title>{{ page_title }}</title>
<meta name="description" content="{{ page_description }}">
<link rel="canonical" href="{{ meta.url }}/">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ settings.site.logo_emoji }}</text></svg>">

<meta property="og:type" content="website">
<meta property="og:locale" content="nl_NL">
<meta property="og:site_name" content="{{ settings.site.naam_deel1 }} {{ settings.site.naam_deel2 }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ meta.url }}/">
{% if settings.hero.foto %}<meta property="og:image" content="{{ meta.url }}{{ settings.hero.foto }}">{% endif %}
<meta name="twitter:card" content="{% if settings.hero.foto %}summary_large_image{% else %}summary{% endif %}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": {{ (settings.site.naam_deel1 + " " + settings.site.naam_deel2) | dump | safe }},
  "description": {{ settings.hero.lead | dump | safe }},
  "url": {{ (meta.url + "/") | dump | safe }},
  "email": {{ settings.contact.email | dump | safe }},
  "telephone": {{ settings.contact.telefoon | dump | safe }},
  "areaServed": {{ settings.praktisch.werkgebied | dump | safe }}
  {% if settings.hero.foto %},"image": {{ (meta.url + settings.hero.foto) | dump | safe }}{% endif %}
}
</script>

{% set bedrijfsnaam = settings.site.naam_deel1 + " " + settings.site.naam_deel2 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": {{ ("In welk gebied is " + bedrijfsnaam + " werkzaam?") | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ settings.praktisch.werkgebied | dump | safe }} }
    },
    {
      "@type": "Question",
      "name": "Wordt kraamzorg vergoed?",
      "acceptedAnswer": { "@type": "Answer", "text": {{ settings.praktisch.vergoeding | dump | safe }} }
    },
    {
      "@type": "Question",
      "name": {{ ("Hoe ver van tevoren moet ik " + bedrijfsnaam + " boeken?") | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ settings.praktisch.beschikbaarheid | dump | safe }} }
    }
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="site-header" id="top">
  <nav class="navbar">
    <a href="#top" class="logo">
      <span class="logo-mark" aria-hidden="true">{{ settings.site.logo_emoji }}</span>
      <span class="logo-text">{{ settings.site.naam_deel1 }} <em>{{ settings.site.naam_deel2 }}</em></span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu openen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#over-mij">Over mij</a></li>
      <li><a href="#diensten">Wat ik doe</a></li>
      <li><a href="#werkwijze">Werkwijze</a></li>
      <li><a href="#reviews">Reviews</a></li>
      <li><a href="#praktisch">Praktisch</a></li>
      <li><a href="#contact" class="nav-cta">Contact</a></li>
    </ul>
  </nav>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  {% if settings.footer.keurmerken and settings.footer.keurmerken.length %}
  <div class="footer-keurmerken">
    {% for keurmerk in settings.footer.keurmerken %}
    {% if keurmerk.link %}
    <a href="{{ keurmerk.link }}" target="_blank" rel="noopener noreferrer">
      <img src="{{ keurmerk.logo }}" alt="{{ keurmerk.naam }}" loading="lazy">
    </a>
    {% else %}
    <img src="{{ keurmerk.logo }}" alt="{{ keurmerk.naam }}" loading="lazy">
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
  <p>&copy; {{ currentYear }} {{ settings.site.naam_deel1 }} {{ settings.site.naam_deel2 }} — {{ settings.footer.tekst }}</p>
</footer>

<script src="/js/main.js"></script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
